{
  "name": "hotel-osamma-desktop",
  "productName": "Hotel Osamma",
  "version": "1.0.0",
  "description": "Desktop shell for the Hotel Osamma management system",
  "main": "main.js",
  "author": "Hotel Osamma",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.hotelosamma.desktop",
    "productName": "Hotel Osamma",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "HotelOsamma-Desktop.exe"
    }
  }
}
